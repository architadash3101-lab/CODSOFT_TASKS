{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run game in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Run game in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Run unbeatable proof (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/test_unbeatable.js"
    }
  ]
}
